                               :riguardaGara :Gara_Germania_2023 ;
                               :riguardaPilota :Martin ;
                               :haPosizione 1 ;
                               rdfs:comment "Risultato Martin - GP di Germania 2023"@it ;
                               rdfs:label "Risultato del pilota Martin alla gara ufficiale GP della Germania 2023"@it .


###  http://www.semanticweb.org/motogp/Risultato_Martin_Sprint_Germania2023
:Risultato_Martin_Sprint_Germania2023 rdf:type owl:NamedIndividual ,
                                               :RisultatoGara ;
                                      :riguardaGara :Sprint_Germania_2023 ;
                                      :riguardaPilota :Martin ;
                                      :haPosizione 1 ;
                                      rdfs:comment "Risultato della Sprint del GP Germania, in cui Martin conclde in prima posizione"@it ;
                                      rdfs:label "Risultato Martin gara sprint Germania"@it .


###  http://www.semanticweb.org/motogp/Rossi
:Rossi rdf:type owl:NamedIndividual ,
                :Pilota ;
       :haCognome "Rossi" ;
       :haDataNascita "1979-02-16"^^xsd:date ;
       :haNazionalita "Italiano" ;
       :haNome "Valentino" ;
       :haNumeroGara 46 ;
       :haStagioniDisputate 26 ;
       rdfs:comment "9 volte campione del mondo. Inserito per illustrare l'inferenza PilotaVeterano."@it ;
       rdfs:label "Valentino Rossi"@it .


###  http://www.semanticweb.org/motogp/Sachsenring
:Sachsenring rdf:type owl:NamedIndividual ,
                      :Circuito ;
             :haNomeCircuito "Sachsenring" ;
             rdfs:comment "Circuito tedesco."@it ;
             rdfs:label "Sachsenring"@it .


###  http://www.semanticweb.org/motogp/Sprint_Germania_2023
:Sprint_Germania_2023 rdf:type owl:NamedIndividual ,
                               :GaraSprint ;
                      owl:differentFrom :Sprint_Italia_2023 ;
                      rdfs:comment "Gara sprint del Gran Premio della Germania 2023"@it ;
                      rdfs:label "Sprint - GP Germania 2023"@it .


###  http://www.semanticweb.org/motogp/Sprint_Italia_2023
:Sprint_Italia_2023 rdf:type owl:NamedIndividual ,
                             :GaraSprint ;
                    rdfs:comment "Gara sprint del Gran Premio d'Italia 2023"@it ;
                    rdfs:label "Sprint - GP d'Italia 2023"@it .


###  http://www.semanticweb.org/motogp/StagioneMotoGP2023
:StagioneMotoGP2023 rdf:type owl:NamedIndividual ,
                             :Stagione ;
                    list:hasFirstItem :GP_Italia_2023 ;
                    :haGranPremio :GP_Germania_2023 ,
                                  :GP_Italia_2023 ,
                                  :GP_Olanda_2023 ;
                    rdfs:comment "Stagione 2023 del campionato MotoGP, composta da una sequenza di Gran Premi"@it ;
                    rdfs:label "Stagione MotoGP 2023"@it .


###  http://www.semanticweb.org/motogp/Tardozzi
:Tardozzi rdf:type owl:NamedIndividual ,
                   :TeamManager ;
          rdfs:comment "Team manager associato al team Ducati Lenovo"@it ;
          rdfs:label "Davide Tardozzi"@it .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Gara
                :ProvaLibera
                :Qualifica
              )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :Acosta
                        :Bagnaia
                        :Bastianini
                        :Fernandez
                        :Holgado
                        :Martin
                        :Rossi
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :Assen
                        :Mugello
                        :Sachsenring
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :GP_Germania_2023
                        :GP_Italia_2023
                        :GP_Olanda_2023
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :Moto2
                        :Moto3
                        :MotoGP
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :Risultato_Bagnaia_Germania2023
                        :Risultato_Bagnaia_Italia2023
                        :Risultato_Bagnaia_Sprint2023
                        :Risultato_Bagnaia_Sprint_Germania2023
                        :Risultato_Martin_Germania2023
                        :Risultato_Martin_Sprint_Germania2023
                      )
] .


#################################################################
#    Rules
#################################################################

:p rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:gs rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:gp rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:event rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:p1 rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:p2 rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:t rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

