                              :riguardaPilota :Bagnaia ;
                              :haPosizione 1 ;
                              :haPunti 25 ;
                              rdfs:comment "Risultato del pilota Bagnaia alla gara ufficiale GP d'Italia 2023"@it ;
                              rdfs:label "Risultato Bagnaia - GP d'Italia 2023"@it .


