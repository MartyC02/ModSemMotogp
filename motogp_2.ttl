@prefix : <http://www.semanticweb.org/motogp/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix list: <http://www.ontologydesignpatterns.org/cp/owl/list.owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix schema: <http://schema.org/> .
@base <http://www.semanticweb.org/motogp/> .

<http://www.semanticweb.org/motogp/> rdf:type owl:Ontology ;
                                      owl:imports <http://www.ontologydesignpatterns.org/cp/owl/list.owl> ;
                                      dc:creator "Martina Celli" ;
                                      dc:date "2026-06-29"^^xsd:date ;
                                      dc:description "Ontologia per la rappresentazione del campionato del mondo di MotoGP: piloti, team, costruttori, motociclette, circuiti, gran premi, sessioni e risultati di gara."@it ;
                                      dc:title "Ontologia MotoGP"@it ;
                                      vann:preferredNamespacePrefix "motogp" ;
                                      vann:preferredNamespaceUri "http://www.semanticweb.org/motogp/" ;
                                      rdfs:label "Ontologia MotoGP"@it .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/creator
dc:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/date
dc:date rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
dc:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
dc:title rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty .


###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/motogp/compagnoDiTeam
:compagnoDiTeam rdf:type owl:ObjectProperty ,
                         owl:SymmetricProperty ;
                rdfs:domain :Pilota ;
                rdfs:range :Pilota ;
                rdfs:comment "Relazione che collega due piloti che corrono per lo stesso Team"@it ;
                rdfs:label "Compagno di Team"@it .


###  http://www.semanticweb.org/motogp/correPer
:correPer rdf:type owl:ObjectProperty ;
          owl:inverseOf :schiera ;
          rdfs:domain :Pilota ;
          rdfs:range :Team ;
          rdfs:comment "Collega un pilota al team per cui gareggia."@it ;
          rdfs:label "corre per"@it .


###  http://www.semanticweb.org/motogp/gareggiaIn
:gareggiaIn rdf:type owl:ObjectProperty ;
            rdfs:domain :Pilota ;
            rdfs:range :Categoria ;
            rdfs:comment "Collega un pilota alla categoria in cui corre."@it ;
            rdfs:label "gareggia in"@it .


###  http://www.semanticweb.org/motogp/granPremioDiStagione
:granPremioDiStagione rdf:type owl:ObjectProperty ;
                      owl:inverseOf :haGranPremio ;
                      rdfs:domain :GranPremio ;
                      rdfs:range :Stagione ;
                      rdfs:comment "Collega un gran premio alla stagione di cui fa parte, inversa di haGranPremio"@it ;
                      rdfs:label "Gran premio di stagione"@it .


###  http://www.semanticweb.org/motogp/guidaMoto
:guidaMoto rdf:type owl:ObjectProperty ;
           rdfs:domain :Pilota ;
           rdfs:range :Motocicletta ;
           owl:propertyChainAxiom ( :correPer
                                    :utilizzaMoto
                                  ) ;
           rdfs:comment "Proprieta' INFERITA via property chain: collega il pilota alla motocicletta che guida tramite il suo team."@it ;
           rdfs:label "guida la moto"@it .


###  http://www.semanticweb.org/motogp/guidaMotoDi
:guidaMotoDi rdf:type owl:ObjectProperty ;
             rdfs:domain :Pilota ;
             rdfs:range :Costruttore ;
             owl:propertyChainAxiom ( :correPer
                                      :utilizzaMoto
                                      :haCostruttore
                                    ) ;
             rdfs:comment "Proprieta' INFERITA via property chain: collega il pilota al costruttore della moto del suo team."@it ;
             rdfs:label "guida la moto di"@it .


###  http://www.semanticweb.org/motogp/haCostruttore
:haCostruttore rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Motocicletta ;
               rdfs:range :Costruttore ;
               rdfs:comment "Collega una motocicletta al costruttore che la produce. Funzionale."@it ;
               rdfs:label "ha costruttore"@it .


###  http://www.semanticweb.org/motogp/haDominatoWeekend
:haDominatoWeekend rdf:type owl:ObjectProperty ;
                   rdfs:domain :Pilota ;
                   rdfs:range :GranPremio ;
                   rdfs:comment "Indica un pilota che ha vinto sia la gara sprint sia che gara ufficiale"@it ;
                   rdfs:label "ha dominato weekend"@it .


###  http://www.semanticweb.org/motogp/haGranPremio
:haGranPremio rdf:type owl:ObjectProperty ;
              rdfs:domain :Stagione ;
              rdfs:range :GranPremio ;
              rdfs:comment "Collega una stagione ai gran premi che compongono il calendario"@it ;
              rdfs:label "Ha gran premio"@it .


###  http://www.semanticweb.org/motogp/haIngegnere
:haIngegnere rdf:type owl:ObjectProperty ;
             rdfs:domain :Team ;
             rdfs:range :Ingegnere ;
             rdfs:comment "Descrive la relazione che un team ha un ingegnere"@it ;
             rdfs:label "ha Ingegnere"@it .


###  http://www.semanticweb.org/motogp/haPartecipatoAGranPremio
:haPartecipatoAGranPremio rdf:type owl:ObjectProperty ;
                          rdfs:domain :Pilota ;
                          rdfs:range :GranPremio ;
                          rdfs:comment "Collega un pilota a un gran Premio a cui ha partecipato"@it ;
                          rdfs:label "ha partecipato a Gran Premio"@it .


###  http://www.semanticweb.org/motogp/haRisultato
:haRisultato rdf:type owl:ObjectProperty ;
             owl:inverseOf :riguardaGara ;
             rdfs:domain :Gara ;
             rdfs:range :RisultatoGara ;
             rdfs:comment "Collega una gara ai risultati dei piloti."@it ;
             rdfs:label "ha risultato"@it .


###  http://www.semanticweb.org/motogp/haRisultatoPilota
:haRisultatoPilota rdf:type owl:ObjectProperty ;
                   owl:inverseOf :riguardaPilota ;
                   rdfs:domain :Pilota ;
                   rdfs:range :RisultatoGara ;
                   rdfs:comment "Collega un pilota ai suoi risultati di gara. Inversa di riguardaPilota"@it ;
                   rdfs:label "ha risultato pilota"@it .


###  http://www.semanticweb.org/motogp/haSessione
:haSessione rdf:type owl:ObjectProperty ;
            owl:inverseOf :sessioneDiGranPremio ;
            rdfs:domain :GranPremio ;
            rdfs:range :Sessione ;
            rdfs:comment "Collega un Gran Premio alle sue sessioni (libere, qualifica, gara)."@it ;
            rdfs:label "ha sessione"@it .


###  http://www.semanticweb.org/motogp/haTeamManager
:haTeamManager rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Team ;
               rdfs:range :TeamManager ;
               rdfs:comment "Relazione che indica che un team ha un Team manager"@it ;
               rdfs:label "ha Team Manager"@it .


###  http://www.semanticweb.org/motogp/haTeamVincitore
:haTeamVincitore rdf:type owl:ObjectProperty ;
                 rdfs:domain :Gara ;
                 rdfs:range :Team ;
                 rdfs:comment "Collega una gara al team del pilota vincitore"@it ;
                 rdfs:label "ha Team vincitore"@it .


###  http://www.semanticweb.org/motogp/haVintoGara
:haVintoGara rdf:type owl:ObjectProperty ;
             rdfs:domain :Pilota ;
             rdfs:range :Gara ;
             rdfs:comment "Collega un pilota a una gara che ha vinto."@it ;
             rdfs:label "ha vinto gara"@it .


###  http://www.semanticweb.org/motogp/ospita
:ospita rdf:type owl:ObjectProperty ;
        owl:inverseOf :ospitatoIn ;
        rdfs:domain :Circuito ;
        rdfs:range :GranPremio ;
        rdfs:comment "Collega un circuito ai Gran Premi che ospita."@it ;
        rdfs:label "ospita"@it .


###  http://www.semanticweb.org/motogp/ospitatoIn
:ospitatoIn rdf:type owl:ObjectProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :GranPremio ;
            rdfs:range :Circuito ;
            rdfs:comment "Collega un Gran Premio al circuito che lo ospita. Inversa di ospita."@it ;
            rdfs:label "ospitato in"@it .


###  http://www.semanticweb.org/motogp/precedeInCalendario
:precedeInCalendario rdf:type owl:ObjectProperty ,
                              owl:TransitiveProperty ;
                     rdfs:domain :GranPremio ;
                     rdfs:range :GranPremio ;
                     rdfs:comment "Ordina i Gran Premi nel calendario. Transitiva: se A precede B e B precede C, allora A precede C (inferito)."@it ;
                     rdfs:label "precede in calendario"@it .


###  http://www.semanticweb.org/motogp/riguardaGara
:riguardaGara rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :RisultatoGara ;
              rdfs:range :Gara ;
              rdfs:comment "Collega un risultato alla gara a cui si riferisce. Inversa di haRisultato"@it ;
              rdfs:label "riguarda gara"@it .


###  http://www.semanticweb.org/motogp/riguardaGranPremio
:riguardaGranPremio rdf:type owl:ObjectProperty ;
                    rdfs:domain :RisultatoGara ;
                    rdfs:range :GranPremio ;
                    owl:propertyChainAxiom ( :riguardaGara
                                             :sessioneDiGranPremio
                                           ) ;
                    rdfs:comment "Proprietà inferita tramite property chain: collega un risultato di gara al Gran Premio in cui la gara si svolge"@it ;
                    rdfs:label "riguarda Gran Premio"@it .


###  http://www.semanticweb.org/motogp/riguardaPilota
:riguardaPilota rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :RisultatoGara ;
                rdfs:range :Pilota ;
                rdfs:comment "Collega un risultato di gara al pilota a cui si riferisce."@it ;
                rdfs:label "riguarda pilota"@it .


###  http://www.semanticweb.org/motogp/schiera
:schiera rdf:type owl:ObjectProperty ;
         rdfs:domain :Team ;
         rdfs:range :Pilota ;
         rdfs:comment "Collega un team ai piloti che mette in pista. Inversa di correPer."@it ;
         rdfs:label "schiera"@it .


###  http://www.semanticweb.org/motogp/sessioneDiGranPremio
:sessioneDiGranPremio rdf:type owl:ObjectProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain :Sessione ;
                      rdfs:range :GranPremio ;
                      rdfs:comment "Collega una sessione al gran premio di cui fa parte, inversa di haSessione"@it ;
                      rdfs:label "sessione di Gran premio"@it .


###  http://www.semanticweb.org/motogp/utilizzaMoto
:utilizzaMoto rdf:type owl:ObjectProperty ;
              rdfs:domain :Team ;
              rdfs:range :Motocicletta ;
              rdfs:comment "Collega un team alla motocicletta che impiega."@it ;
              rdfs:label "utilizza moto"@it .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/motogp/eCampione
:eCampione rdf:type owl:DatatypeProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :Pilota ;
           rdfs:range xsd:boolean ;
           rdfs:comment "Vero se il pilota e' campione del mondo in carica."@it ;
           rdfs:label "e' campione"@it .


###  http://www.semanticweb.org/motogp/haCilindrata
:haCilindrata rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Motocicletta ;
              rdfs:range xsd:integer ;
              rdfs:comment "Cilindrata in cc della motocicletta."@it ;
              rdfs:label "ha cilindrata"@it .


###  http://www.semanticweb.org/motogp/haCognome
:haCognome rdf:type owl:DatatypeProperty ;
           rdfs:domain :Persona ;
           rdfs:range xsd:string ;
           rdfs:comment "Cognome della persona."@it ;
           rdfs:label "ha cognome"@it .


###  http://www.semanticweb.org/motogp/haDataGara
:haDataGara rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :GranPremio ;
            rdfs:range xsd:date ;
            rdfs:comment "Data di svolgimento della gara."@it ;
            rdfs:label "ha data gara"@it .


###  http://www.semanticweb.org/motogp/haDataNascita
:haDataNascita rdf:type owl:DatatypeProperty ;
               rdfs:domain :Persona ;
               rdfs:range xsd:date ;
               dc:title "ha data nascita"@it ;
               rdfs:comment "indica la data di nascita"@it .


###  http://www.semanticweb.org/motogp/haNazionalita
:haNazionalita rdf:type owl:DatatypeProperty ;
               rdfs:domain :Persona ;
               rdfs:range xsd:string ;
               dc:title "ha nazionalità"@it ;
               rdfs:comment "indica la nazionalità"@it .


###  http://www.semanticweb.org/motogp/haNome
:haNome rdf:type owl:DatatypeProperty ;
        rdfs:domain :Persona ;
        rdfs:range xsd:string ;
        rdfs:comment "Nome di battesimo della persona."@it ;
        rdfs:label "ha nome"@it .


###  http://www.semanticweb.org/motogp/haNomeCircuito
:haNomeCircuito rdf:type owl:DatatypeProperty ;
                rdfs:domain :Circuito ;
                rdfs:range xsd:string ;
                rdfs:comment "Denominazione del circuito."@it ;
                rdfs:label "ha nome circuito"@it .


###  http://www.semanticweb.org/motogp/haNomeEvento
:haNomeEvento rdf:type owl:DatatypeProperty ;
              rdfs:domain :GranPremio ;
              rdfs:range xsd:string ;
              rdfs:comment "Denominazione ufficiale del Gran Premio."@it ;
              rdfs:label "ha nome evento"@it .


###  http://www.semanticweb.org/motogp/haNomeTeam
:haNomeTeam rdf:type owl:DatatypeProperty ;
            rdfs:domain :Team ;
            rdfs:range xsd:string ;
            rdfs:comment "Denominazione del team."@it ;
            rdfs:label "ha nome team"@it .


###  http://www.semanticweb.org/motogp/haNumeroGara
:haNumeroGara rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Pilota ;
              rdfs:range xsd:integer ;
              rdfs:comment "Numero fisso del pilota."@it ;
              rdfs:label "ha numero di gara"@it .


###  http://www.semanticweb.org/motogp/haNumeroRound
:haNumeroRound rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :GranPremio ;
               rdfs:range xsd:integer ;
               rdfs:comment "Indica il numero d'ordine del gran premio nel calendario della stagione"@it ;
               rdfs:label "ha numero round"@it .


###  http://www.semanticweb.org/motogp/haPosizione
:haPosizione rdf:type owl:DatatypeProperty ;
             rdfs:domain :RisultatoGara ;
             rdfs:range xsd:integer ;
             rdfs:comment "Posizione finale del pilota nella gara."@it ;
             rdfs:label "ha posizione"@it .


###  http://www.semanticweb.org/motogp/haPunti
:haPunti rdf:type owl:DatatypeProperty ;
         rdfs:domain :RisultatoGara ;
         rdfs:range xsd:integer ;
         rdfs:comment "Punti conquistati nella gara."@it ;
         rdfs:label "ha punti"@it .


###  http://www.semanticweb.org/motogp/haStagioniDisputate
:haStagioniDisputate rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :Pilota ;
                     rdfs:range xsd:integer ;
                     rdfs:comment "Numero di stagioni disputate dal pilota. Usata per inferire PilotaVeterano."@it ;
                     rdfs:label "ha stagioni disputate"@it .


#################################################################
#    Classes
#################################################################

###  http://schema.org/Organization
schema:Organization rdf:type owl:Class .


###  http://schema.org/SportsEvent
schema:SportsEvent rdf:type owl:Class .


###  http://www.semanticweb.org/motogp/Campionato
:Campionato rdf:type owl:Class ;
            rdfs:comment "Competizione iridata di una categoria in una stagione."@it ;
            rdfs:label "Campionato"@it .


###  http://www.semanticweb.org/motogp/Categoria
:Categoria rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Class ;
                                 owl:oneOf ( :Moto2
                                             :Moto3
                                             :MotoGP
                                           )
                               ] ;
           rdfs:comment "Classe enumerata: le tre categorie del Motomondiale."@it ;
           rdfs:label "Categoria"@it .


###  http://www.semanticweb.org/motogp/Circuito
:Circuito rdf:type owl:Class ;
          rdfs:comment "Tracciato permanente che ospita un Gran Premio."@it ;
          rdfs:label "Circuito"@it .


###  http://www.semanticweb.org/motogp/Costruttore
:Costruttore rdf:type owl:Class ;
             rdfs:subClassOf :Organizzazione ;
             rdfs:comment "Casa motociclistica che produce le moto (es. Ducati, Yamaha, Honda, Aprilia, KTM)."@it ;
             rdfs:label "Costruttore"@it .


###  http://www.semanticweb.org/motogp/Gara
:Gara rdf:type owl:Class ;
      rdfs:subClassOf :Sessione ;
      owl:disjointUnionOf ( :GaraPrincipale
                            :GaraSprint
                          ) ;
      rdfs:comment "Sessione di gara che assegna punti per il campionato."@it ;
      rdfs:label "Gara"@it .


###  http://www.semanticweb.org/motogp/GaraPrincipale
:GaraPrincipale rdf:type owl:Class ;
                rdfs:subClassOf :Gara ;
                rdfs:comment "Gara principale della domenica che assegna punti per il campionato."@it ;
                rdfs:label "Gara principale"@it .


###  http://www.semanticweb.org/motogp/GaraSprint
:GaraSprint rdf:type owl:Class ;
            rdfs:subClassOf :Gara ;
            rdfs:comment "Gara breve del sabato che assegna punteggio ridotto."@it ;
            rdfs:label "Gara sprint"@it .


###  http://www.semanticweb.org/motogp/GranPremio
:GranPremio rdf:type owl:Class ;
            rdfs:subClassOf schema:SportsEvent ,
                            list:ListItem ;
            rdfs:comment "Evento sportivo di una tappa del campionato, ospitato in un circuito in una data precisa."@it ;
            rdfs:label "Gran Premio"@it .


###  http://www.semanticweb.org/motogp/Ingegnere
:Ingegnere rdf:type owl:Class ;
           rdfs:subClassOf :Persona ;
           rdfs:comment "Persona che cura lo sviluppo tecnico della motocicletta all'interno di un team."@it ;
           rdfs:label "Ingegnere"@it .


###  http://www.semanticweb.org/motogp/Motocicletta
:Motocicletta rdf:type owl:Class ;
              rdfs:comment "Prototipo da competizione utilizzato in gara, prodotto da un costruttore."@it ;
              rdfs:label "Motocicletta"@it .


###  http://www.semanticweb.org/motogp/Organizzazione
:Organizzazione rdf:type owl:Class ;
                rdfs:subClassOf schema:Organization ;
                owl:disjointWith :Persona ;
                rdfs:comment "Ente collettivo che partecipa al campionato (team o costruttore)."@it ;
                rdfs:label "Organizzazione"@it .


###  http://www.semanticweb.org/motogp/Persona
:Persona rdf:type owl:Class ;
         rdfs:subClassOf foaf:Person ;
         rdfs:comment "Essere umano coinvolto nel campionato (pilota, ingegnere, team manager)."@it ;
         rdfs:label "Persona"@it .


###  http://www.semanticweb.org/motogp/Pilota
:Pilota rdf:type owl:Class ;
        rdfs:subClassOf :Persona ;
        rdfs:comment "Persona che gareggia in una categoria del Motomondiale guidando una motocicletta per un team."@it ;
        rdfs:label "Pilota"@it .


###  http://www.semanticweb.org/motogp/PilotaClasseRegina
:PilotaClasseRegina rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( :Pilota
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty :gareggiaIn ;
                                                                 owl:hasValue :MotoGP
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] ;
                    rdfs:comment "Pilota che gareggia nella categoria MotoGP."@it ;
                    rdfs:label "Pilota classe regina"@it .


###  http://www.semanticweb.org/motogp/PilotaDaPodio
:PilotaDaPodio rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :Pilota
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :haRisultatoPilota ;
                                                            owl:someValuesFrom :RisultatoPodio
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
               rdfs:subClassOf :Pilota ;
               rdfs:comment "Pilota che ha ottenuto almeno un risultato classificato come podio"@it ;
               rdfs:label "Pilota da podio"@it .


###  http://www.semanticweb.org/motogp/PilotaEsordiente
:PilotaEsordiente rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( :Pilota
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :haStagioniDisputate ;
                                                               owl:hasValue 1
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                  rdfs:comment "Pilota alla sua prima stagione (haStagioniDisputate = 1). Classe DEFINITA, contrapposta a PilotaVeterano."@it ;
                  rdfs:label "Pilota esordiente"@it .


###  http://www.semanticweb.org/motogp/PilotaMoto2
:PilotaMoto2 rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( :Pilota
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :gareggiaIn ;
                                                          owl:hasValue :Moto2
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ;
             rdfs:subClassOf :Pilota ;
             rdfs:comment "Pilota che gareggia nella categoria Moto2"@it ;
             rdfs:label "Pilota Moto 2"@it .


###  http://www.semanticweb.org/motogp/PilotaMoto3
:PilotaMoto3 rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( :Pilota
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :gareggiaIn ;
                                                          owl:hasValue :Moto3
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ;
             rdfs:subClassOf :Pilota ;
             rdfs:comment "Pilota che gareggia nella categoria Moto3"@it ;
             rdfs:label "Pilota Moto 3"@it .


###  http://www.semanticweb.org/motogp/PilotaVeterano
:PilotaVeterano rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :Pilota
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :haStagioniDisputate ;
                                                             owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                  owl:onDatatype xsd:integer ;
                                                                                  owl:withRestrictions ( [ xsd:minInclusive 10
                                                                                                         ]
                                                                                                       )
                                                                                ]
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:comment "Pilota con almeno 10 stagioni disputate. Classe DEFINITA: il reasoner la popola in base ad haStagioniDisputate."@it ;
                rdfs:label "Pilota veterano"@it .


###  http://www.semanticweb.org/motogp/PilotaVincente
:PilotaVincente rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :Pilota
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :haRisultatoPilota ;
                                                             owl:someValuesFrom :RisultatoVittoria
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:comment "Pilota che ha vinto almeno un Gran Premio. Classe DEFINITA (restrizione some)."@it ;
                rdfs:label "Pilota vincente"@it .


###  http://www.semanticweb.org/motogp/ProvaLibera
:ProvaLibera rdf:type owl:Class ;
             rdfs:subClassOf :Sessione ;
             rdfs:comment "Sessione di prove libere."@it ;
             rdfs:label "Prova libera"@it .


###  http://www.semanticweb.org/motogp/Qualifica
:Qualifica rdf:type owl:Class ;
           rdfs:subClassOf :Sessione ;
           rdfs:comment "Sessione che determina la griglia di partenza."@it ;
           rdfs:label "Qualifica"@it .


###  http://www.semanticweb.org/motogp/RisultatoGara
:RisultatoGara rdf:type owl:Class ;
               rdfs:comment "Esito di un pilota in una specifica gara (posizione e punti)."@it ;
               rdfs:label "Risultato di gara"@it .


###  http://www.semanticweb.org/motogp/RisultatoPodio
:RisultatoPodio rdf:type owl:Class ;
                rdfs:subClassOf :RisultatoGara ;
                rdfs:comment "Risultato di gara in cui il pilota conclude tra la prima e la terza posizione"@it ;
                rdfs:label "Risultato da podio"@it .


###  http://www.semanticweb.org/motogp/RisultatoVittoria
:RisultatoVittoria rdf:type owl:Class ;
                   owl:equivalentClass [ owl:intersectionOf ( :RisultatoGara
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty :haPosizione ;
                                                                owl:hasValue 1
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                   rdfs:subClassOf :RisultatoPodio ;
                   rdfs:comment "Risultato di gara in cui il pilota conclude in prima posizione"@it ;
                   rdfs:label "Risultato vittoria"@it .


###  http://www.semanticweb.org/motogp/Sessione
:Sessione rdf:type owl:Class ;
          rdfs:comment "Turno in pista all'interno di un weekend di gara."@it ;
          rdfs:label "Sessione"@it .


###  http://www.semanticweb.org/motogp/Stagione
:Stagione rdf:type owl:Class ;
          rdfs:subClassOf list:List ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :haGranPremio ;
                            owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
                            owl:onClass :GranPremio
                          ] ;
          rdfs:comment "Annata agonistica composta da una sequenza di Gran Premi."@it ;
          rdfs:label "Stagione"@it .


###  http://www.semanticweb.org/motogp/Team
:Team rdf:type owl:Class ;
      rdfs:subClassOf :Organizzazione ;
      rdfs:comment "Squadra corse che schiera uno o più piloti e utilizza le moto di un costruttore."@it ;
      rdfs:label "Team"@it .


###  http://www.semanticweb.org/motogp/TeamCompleto
:TeamCompleto rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( :Team
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :haIngegnere ;
                                                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                           owl:onClass :Ingegnere
                                                         ]
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :haTeamManager ;
                                                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                           owl:onClass :TeamManager
                                                         ]
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :schiera ;
                                                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                           owl:onClass :Pilota
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
              rdfs:subClassOf :Team ;
              rdfs:comment "Team che ha almeno un pilota, almeno un ingegnere  e almeno un team manager"@it ;
              rdfs:label "Team completo"@it .


###  http://www.semanticweb.org/motogp/TeamManager
:TeamManager rdf:type owl:Class ;
             rdfs:subClassOf :Persona ;
             rdfs:comment "Persona responsabile della gestione di un team."@it ;
             rdfs:label "Team manager"@it .


###  http://www.semanticweb.org/motogp/TeamSatellite
:TeamSatellite rdf:type owl:Class ;
               rdfs:subClassOf :Team ;
               owl:disjointWith :TeamUfficiale ;
               rdfs:comment "Team che utilizza le stesse moto di un team Ufficiale ma è un team privato"@it ;
               rdfs:label "Team satellite"@it .


###  http://www.semanticweb.org/motogp/TeamUfficiale
:TeamUfficiale rdf:type owl:Class ;
               rdfs:subClassOf :Team ;
               rdfs:comment "Team ufficiale"@it ;
               rdfs:label "Team ufficiale"@it .


###  http://www.semanticweb.org/motogp/TeamVincente
:TeamVincente rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( :Team
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :schiera ;
                                                           owl:someValuesFrom :PilotaVincente
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
              rdfs:comment "Team che schiera almeno un pilota vincente."@it ;
              rdfs:label "Team vincente"@it .


###  http://xmlns.com/foaf/0.1/Person
foaf:Person rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/motogp/Acosta
